{
  "schemaVersion": 1,
  "id": "io.github.terrifiedbug.omathock",
  "name": "OmaThock",
  "version": "0.1.0",
  "author": "TerrifiedBug",
  "license": "MIT",
  "description": "Mechanical keyboard sounds on every keypress. No input group, no daemon: Hyprland's Lua event bus feeds QtMultimedia inside the shell. Plays thock soundpacks.",
  "homepage": "https://github.com/TerrifiedBug/omathock",
  "kinds": ["bar-widget", "service"],
  "entryPoints": { "barWidget": "Panel.qml", "service": "Service.qml" },
  "barWidget": {
    "displayName": "OmaThock",
    "description": "Mechanical keyboard sounds: toggle, soundpack, volume.",
    "category": "Audio",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": { "enabled": true, "soundpack": "drop-holy-panda", "volume": 100 },
    "schema": [
      { "key": "enabled", "type": "boolean", "label": "Keyboard sounds", "defaultValue": true },
      { "key": "soundpack", "type": "string", "label": "Soundpack", "description": "Directory name under soundpacks/ (bundled) or ~/.local/share/omathock/soundpacks/", "defaultValue": "drop-holy-panda" },
      { "key": "volume", "type": "integer", "label": "Volume", "min": 0, "max": 100, "step": 5, "defaultValue": 100 }
    ]
  }
}
